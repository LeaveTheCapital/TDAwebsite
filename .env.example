# Copy to .env and fill in the web app config from Firebase console.
# These values are public in the browser bundle. Do not put private keys here.
# Leave the file out, or leave the required values empty, to keep cloud upload
# on this browser only.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. When set, the page refuses other Google accounts before calling Firestore.
# Use the same lowercase email and uid as allowedEmail() / allowedUid() in firestore.rules.
VITE_FIREBASE_ALLOWED_EMAIL=
VITE_FIREBASE_ALLOWED_UID=
